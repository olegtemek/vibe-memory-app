# --- сервер (читает только переменные с префиксом VIBE_MEMORY_) ---
# Порт API
VIBE_MEMORY_SERVER_PORT=8000
# Порт PWA, там же API на том же origin. 0: выключено. Работает, только если PWA встроена в бинарник (Docker-образ)
VIBE_MEMORY_WEB_PORT=8080
# Origin, которым можно ходить в API, через запятую; * — любые
VIBE_MEMORY_SERVER_CORS_ORIGINS=*
# Каталог данных: vibe_memory.db, blobs/, tmp/. Относительный путь считается от server/; в Docker всегда /app/data
VIBE_MEMORY_APP_DATA_DIR=./data
# Порог свободного места для загрузки фото, МБ
VIBE_MEMORY_APP_MIN_FREE_MB=500
# debug, info, warn, error
VIBE_MEMORY_APP_LOG_LEVEL=info

# --- только docker compose ---
# Адрес на хосте, к которому привязаны порты. 127.0.0.1: только через reverse proxy; 0.0.0.0: вся сеть
VIBE_MEMORY_BIND_ADDRESS=127.0.0.1
# Каталог на хосте с базой и фото
VIBE_MEMORY_DATA_DIR=./data
# uid:gid процесса в контейнере; каталог данных должен принадлежать ему
VIBE_MEMORY_DOCKER_USER=10001:10001
