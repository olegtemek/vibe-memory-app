# Адрес и порт
ADDR=:8080
# Каталог данных: vibe_memory.db, blobs/, tmp/. Относительный путь считается от server/
DATA_DIR=./data
# Origin PWA через запятую, сравнение точное
ALLOWED_ORIGINS=http://localhost:5173
# Порог свободного места для PUT, МБ
MIN_FREE_MB=500
# debug, info, warn, error
LOG_LEVEL=info

# --- docker compose (сервер в контейнере всегда слушает :8080 и пишет в /app/data) ---
# Адрес на хосте, к которому привязан порт. 127.0.0.1: только через reverse proxy; 0.0.0.0: вся сеть
VIBE_MEMORY_BIND_ADDRESS=127.0.0.1
# Порт на хосте
VIBE_MEMORY_PORT=8080
# Каталог на хосте с базой и фото
VIBE_MEMORY_DATA_DIR=./data
# uid:gid процесса в контейнере; каталог данных должен принадлежать ему
VIBE_MEMORY_DOCKER_USER=10001:10001
